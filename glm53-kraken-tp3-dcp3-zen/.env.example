# Copy to .env and edit:  cp .env.example .env
# Read by launch.sh, download_checkpoint.sh and validate.sh (and by docker compose).
# Quote values that contain spaces.

# Three GPU indices as nvidia-smi numbers them, comma-separated. All three must be idle
# RTX PRO 6000 Blackwell 96 GB cards; launch.sh refuses to start if any has a compute process.
GPU_IDS="0,1,2"

# Host port for the OpenAI-compatible API (the container listens on 8000).
HOST_PORT=8000
# Interface to publish the port on. 0.0.0.0 = all interfaces (reachable from your LAN);
# 127.0.0.1 = this machine only. There is no API key, so do not expose it to the internet.
BIND_ADDRESS=0.0.0.0

# Host CPUs the container may use (docker --cpuset-cpus syntax, e.g. "0-23" or "8-47").
# Leave empty to use all CPUs.
CPUSET=""

# Hugging Face cache directory for the checkpoint (~178 GB). download_checkpoint.sh fills
# $HF_CACHE_DIR/hub/models--local-inference-lab--GLM-5.3-Flash-NVFP4-MXFP8-CSF-QAD/... and writes
# the verification receipt the launcher checks. Mounted read-only into the container.
HF_CACHE_DIR="/srv/models/glm53-kraken-tp3/huggingface"

# Writable directory for the runtime caches (FlashInfer/Triton/torch.compile JIT, autotune).
# A few GB. Keep it between restarts: the second start is faster.
RUNTIME_CACHE_DIR="/srv/cache/glm53-kraken-tp3-dcp3-zen"

# Optional. Receipt written by download_checkpoint.sh; default $HF_CACHE_DIR/checkpoint-verification.json.
CHECKPOINT_RECEIPT=""

# Optional. csf-qad-2 (default, validated) or default (the original GLM-5.3-Flash-NVFP4 checkpoint:
# ~15% faster prefill, slightly lower decode and KV, ~199 GB; use a separate HF_CACHE_DIR for it).
CHECKPOINT=csf-qad-2

# Optional. Model name clients pass in "model"; validate.sh uses it too.
SERVED_MODEL_NAME=GLM-5.3-Flash-Kraken-TP3

# Optional, for validate.sh: path to a checkout of llm-inference-bench at tag v0.6.2.
BENCH_DIR="./llm-inference-bench"
