# Copy to .env. This is a shell configuration file; use only trusted settings.
# All four devices must be idle RTX PRO 6000 Blackwell 96 GB cards.
GPU_IDS="0,1,2,3"
HOST_PORT=8000
# No authentication is configured. Keep loopback unless separately secured.
BIND_ADDRESS=127.0.0.1

# Put the COMPLETE checkpoint on your fastest local ext4/XFS NVMe filesystem.
# The large Engram files must not be on NFS, tmpfs or a slow USB drive.
MODEL_DIR="/srv/models/deepseek-v41-flash-1017"
RUNTIME_CACHE_DIR="/srv/cache/deepseek-v41-brrr-b12x-hybrid"

# A persistent, private checkout of the exact benchmark revision.
BENCH_DIR="./.bench"
READY_TIMEOUT_S=5400
# Optional Docker CPU affinity, empty means unchanged/all available CPUs.
CPUSET=""
